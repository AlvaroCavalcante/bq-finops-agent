# Vertex AI Configuration (default)
# GOOGLE_CLOUD_LOCATION is for Gemini/Vertex (use global). Do not point it at
# your BigQuery dataset region — that causes model 404s.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Model id for metadata, optimizer, and validator agents.
# Override at deploy time with --update-env-vars GEMINI_MODEL=...
GEMINI_MODEL=gemini-3.8-flash

# BigQuery FinOps settings (job location; independent from Vertex above)
BQ_LOCATION=us-east4
BQ_MAX_BYTES_BILLED=53687091200
BQ_ON_DEMAND_USD_PER_TIB=6.25

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three GOOGLE_* lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here
